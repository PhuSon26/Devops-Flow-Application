pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'Maven-3.9'
        nodejs 'nodejs-20'
    }

    environment {
        APP_NAME = 'car-marketplace'
        RELEASE = '1.0.0'
        BACKEND_DIR = 'car-marketplace/backend'
        FRONTEND_DIR = 'car-marketplace/frontend'
        DOCKER_USER = 'phuson0206'
        DOCKER_PASS = 'Dockerhub-tokens'
        IMAGE_TAG = "${RELEASE}-${BUILD_NUMBER}"
    }

    stages {
        stage('Cleanup Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    java -version
                    mvn -version
                    node --version
                    npm --version
                '''
            }
        }

        stage('Build Backend') {
            steps {
                dir(BACKEND_DIR) {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir(BACKEND_DIR) {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.0.0.4389:sonar \
                                -Dsonar.projectKey=car-marketplace \
                                -Dsonar.projectName="Car Marketplace"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()

                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to Quality Gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir(FRONTEND_DIR) {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    docker.build(
                        "${DOCKER_USER}/car-marketplace-backend:${IMAGE_TAG}",
                        "-f ${BACKEND_DIR}/Dockerfile ${BACKEND_DIR}"
                    )

                    docker.build(
                        "${DOCKER_USER}/car-marketplace-frontend:${IMAGE_TAG}",
                        "-f ${FRONTEND_DIR}/Dockerfile ${FRONTEND_DIR}"
                    )
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -eu

                    echo "Scanning backend image..."
                    trivy image \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        --no-progress \
                        --format table \
                        ${DOCKER_USER}/car-marketplace-backend:${IMAGE_TAG}

                    echo "Scanning frontend image..."
                    trivy image \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        --no-progress \
                        --format table \
                        ${DOCKER_USER}/car-marketplace-frontend:${IMAGE_TAG}
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                script {
                    docker.withRegistry('', DOCKER_PASS) {
                        def backendImage = docker.image(
                            "${DOCKER_USER}/car-marketplace-backend:${IMAGE_TAG}"
                        )

                        def frontendImage = docker.image(
                            "${DOCKER_USER}/car-marketplace-frontend:${IMAGE_TAG}"
                        )

                        backendImage.push()
                        backendImage.push('latest')

                        frontendImage.push()
                        frontendImage.push('latest')
                    }
                }
            }
        }

        stage("Cleanup Artifacts") {
            steps {
                script {
                    sh '''
                    docker rmi ${DOCKER_USER}/car-marketplace-backend:${IMAGE_TAG}
                    docker rmi ${DOCKER_USER}/car-marketplace-frontend:${IMAGE_TAG}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Backend and frontend builds completed successfully!'
            echo "Backend image: ${DOCKER_USER}/car-marketplace-backend:${IMAGE_TAG}"
            echo "Frontend image: ${DOCKER_USER}/car-marketplace-frontend:${IMAGE_TAG}"
        }

        failure {
            echo 'Build failed. Check the Console Output.'
        }
    }
}