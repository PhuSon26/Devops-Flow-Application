
pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'Maven-3.9'
        nodejs 'nodejs-20'
    }

    environment {
        BACKEND_DIR = 'car-marketplace/backend'
        FRONTEND_DIR = 'car-marketplace/frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    java -version
                    mvn -version
                    node --version
                    npm --version
                '''
            }
        }

        stage('Build Backend') {
            steps {
                dir(BACKEND_DIR) {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir(FRONTEND_DIR) {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo 'Backend and frontend builds completed successfully!'
        }

        failure {
            echo 'Build failed. Check the Console Output.'
        }
    }
}